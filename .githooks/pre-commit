#!/bin/sh
# gate hook: the pre-commit stage.
#
# 两项检查在提交落地前跑：
#   1. 用 rustfmt 格式化暂存区里的 Rust 文件；
#   2. 代码语言守卫按 `.gate.toml` 检查暂存的文件。
#
# 门禁内置在 pengj-templates-cli 里。本钩子优先用 PATH 上的 CLI；
# 本仓库（模板自身）尚未安装发行版时，退回 cargo run 走工作区源码。

set -e

root=$(git rev-parse --show-toplevel)
cd "$root"

if command -v pengj-templates-cli >/dev/null 2>&1; then
    exec pengj-templates-cli gate hook pre-commit
fi

if [ -f "crates/cli/Cargo.toml" ]; then
    exec cargo run --quiet -p pengj-templates-cli -- gate hook pre-commit
fi

echo "[gate] pengj-templates-cli was not found on PATH." >&2
echo "[gate] install it once and the commit gate comes with it:" >&2
echo "[gate]   irm https://github.com/pengjiaxusz/pengj-templates/releases/latest/download/install.ps1 | iex" >&2
echo "[gate]   curl -fsSL https://github.com/pengjiaxusz/pengj-templates/releases/latest/download/install.sh | sh" >&2
exit 2
