#!/bin/sh
# The pre-commit hook: rustfmt the staged Rust files and guard the code
# language. The gate is a standalone Rust package, so it is invoked through
# `cargo run`; a prebuilt binary is used when one is present to keep the hook
# fast.
#
# The gate lives in `tools/gate`, outside the project's workspace, because the
# workspace manifest belongs to the project.

set -e

root=$(git rev-parse --show-toplevel)
cd "$root"

manifest="tools/gate/Cargo.toml"
binary="tools/gate/target/debug/gate"

if [ -x "$binary" ] && [ "$binary" -nt "$manifest" ]; then
    exec "$binary" hook pre-commit
fi

exec cargo run --quiet --manifest-path "$manifest" -- hook pre-commit
