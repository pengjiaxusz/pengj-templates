{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pengj-templates",
  "version": "0.2.5",
  "identifier": "com.pengj.templates",
  "build": {
    "beforeDevCommand": "pnpm --dir crates/app dev",
    "devUrl": "http://localhost:43999",
    "beforeBuildCommand": "pnpm --filter pengj-app build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "pengj-templates",
        "width": 1000,
        "height": 700,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../templates": "templates"
    }
  }
}
