#!/bin/sh
# gate hook: {% if options["skill_lang"] | default("zh") == "en" %}the pre-commit stage.{% else %}提交前的 pre-commit 阶段。{% endif %}
#
# {% if options["skill_lang"] | default("zh") == "en" %}Two checks run before a commit lands:
#   1. the staged Rust files are formatted with rustfmt;
#   2. the code language guard checks the staged files against `.gate.toml`.{% else %}提交落地前会跑两项检查：
#   1. 用 rustfmt 格式化暂存区里的 Rust 文件；
#   2. 代码语言守卫按 `.gate.toml` 检查暂存的文件。{% endif %}
#
# {% if options["skill_lang"] | default("zh") == "en" %}The gate lives in `pengj-templates-cli` and nowhere else: this hook only finds the binary and hands the work to `pengj-templates-cli gate hook pre-commit`. One binary covers the template engine, the MCP installer and the commit gate. No CLI means no rule set, so the commit is blocked with install instructions instead of being let through by a check that cannot run.{% else %}门禁只存在于 `pengj-templates-cli` 里：本钩子只负责找到二进制，把活儿交给 `pengj-templates-cli gate hook pre-commit`。一个二进制同时覆盖模板引擎、MCP 安装与提交门禁。没有 CLI 就没有规则集，所以直接拦下提交并给出安装命令，而不是让一个跑不起来的检查放行。{% endif %}

set -e

root=$(git rev-parse --show-toplevel)
cd "$root"

# {% if options["skill_lang"] | default("zh") == "en" %}Locate the CLI: PATH first, then the installation directory. The second step matters for terminals opened before the installer refreshed PATH — without it a working install would look like a missing one.{% else %}定位 CLI：先找 PATH，再回落到安装目录。回落这一步是为了应付「装好 CLI 之前就打开的终端」——PATH 没刷新时不该被当成没装。{% endif %}
if command -v pengj-templates-cli >/dev/null 2>&1; then
    exec pengj-templates-cli gate hook pre-commit
fi

for candidate in \
    "${PENGJ_INSTALL_DIR:+$PENGJ_INSTALL_DIR/bin/pengj-templates-cli.exe}" \
    "${PENGJ_INSTALL_DIR:+$PENGJ_INSTALL_DIR/bin/pengj-templates-cli}" \
    "${LOCALAPPDATA:+$LOCALAPPDATA/pengj-templates/bin/pengj-templates-cli.exe}" \
    "${XDG_DATA_HOME:+$XDG_DATA_HOME/pengj-templates/bin/pengj-templates-cli}" \
    "${HOME:+$HOME/.local/share/pengj-templates/bin/pengj-templates-cli}"
do
    if [ -x "$candidate" ]; then
        exec "$candidate" gate hook pre-commit
    fi
done

echo "[gate] {% if options["skill_lang"] | default("zh") == "en" %}commit blocked: pengj-templates-cli was not found on PATH or in the installation directory.{% else %}提交被拦下：PATH 与安装目录里都找不到 pengj-templates-cli。{% endif %}" >&2
echo "[gate] {% if options["skill_lang"] | default("zh") == "en" %}rustfmt and the code language guard live inside the CLI, so there is no local check to fall back to. Install it once and the gate comes with it:{% else %}rustfmt 与代码语言守卫都在 CLI 里，本地没有另一套检查可回落。安装一次即可带上：{% endif %}" >&2
echo "[gate]   irm https://github.com/pengjiaxusz/pengj-templates/releases/latest/download/install.ps1 | iex" >&2
echo "[gate]   curl -fsSL https://github.com/pengjiaxusz/pengj-templates/releases/latest/download/install.sh | sh" >&2
exit 1
