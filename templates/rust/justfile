# justfile — 常用任务
# 跨平台 shell：unix 用 sh，Windows 用 PowerShell，不强制 bash
[unix]
set shell := ["sh", "-uc"]
[windows]
set shell := ["powershell", "-NoProfile", "-Command"]

default:
    @just --list
{% if "bque" in layers %}
# 全局跨工作树编译排队状态
queue-status:
    @pwsh -NoProfile -File tools/bque-runner.ps1 -Status

# 应急清理全局编译锁状态
queue-clean:
    @pwsh -NoProfile -File tools/bque-runner.ps1 -Clean

# 手动暂停后台编译（让路游戏或交互压测）
queue-pause:
    @pwsh -NoProfile -File tools/bque-runner.ps1 -Pause

# 手动恢复后台编译
queue-resume:
    @pwsh -NoProfile -File tools/bque-runner.ps1 -Resume

# 构建
[windows]
build *ARGS:
    @pwsh -NoProfile -File tools/bque-runner.ps1 -Desc "Cargo Build" -Cmd "cargo build {% raw %}{{ ARGS }}{% endraw %}"

[unix]
build *ARGS:
    cargo build {% raw %}{{ ARGS }}{% endraw %}

# 检查（clippy 全开）
[windows]
check *ARGS:
    @pwsh -NoProfile -File tools/bque-runner.ps1 -Desc "Cargo Clippy" -Cmd "cargo clippy --all-targets --all-features -- -D warnings {% raw %}{{ ARGS }}{% endraw %}"

[unix]
check *ARGS:
    cargo clippy --all-targets --all-features -- -D warnings {% raw %}{{ ARGS }}{% endraw %}

# 测试
[windows]
test *ARGS:
    @pwsh -NoProfile -File tools/bque-runner.ps1 -Desc "Cargo Test" -Cmd "cargo test --all-features {% raw %}{{ ARGS }}{% endraw %}"

[unix]
test *ARGS:
    cargo test --all-features {% raw %}{{ ARGS }}{% endraw %}

# 专项基准测试（bque bench 自动挂起后台编译以提供纯净 CPU 环境）
[windows]
bench *ARGS:
    @pwsh -NoProfile -File tools/bque-runner.ps1 -Bench -Desc "Cargo Bench" -Cmd "cargo bench {% raw %}{{ ARGS }}{% endraw %}"

[unix]
bench *ARGS:
    cargo bench {% raw %}{{ ARGS }}{% endraw %}

# 格式化检查
fmt:
    cargo fmt --check

# 一键全检查（CI 用）
ci: fmt check test
{% else %}
# 构建
build *ARGS:
    cargo build {% raw %}{{ ARGS }}{% endraw %}

# 检查（clippy 全开）
check *ARGS:
    cargo clippy --all-targets --all-features -- -D warnings {% raw %}{{ ARGS }}{% endraw %}

# 测试
test *ARGS:
    cargo test --all-features {% raw %}{{ ARGS }}{% endraw %}

# 格式化检查
fmt:
    cargo fmt --check

# 一键全检查（CI 用）
ci: fmt check test
{% endif %}
