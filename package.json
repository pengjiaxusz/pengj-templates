{
  "name": "pengj-rust-template",
  "version": "0.60.0-beta.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "cargo run -q --manifest-path tools/gate/Cargo.toml -- hooks install",
    "gate:install": "cargo run -q --manifest-path tools/gate/Cargo.toml -- hooks install",
    "gate:audit": "cargo run -q --manifest-path tools/gate/Cargo.toml -- audit",
    "mcp:doctor": "node .agents/skills/mcp-bootstrap/scripts/ensure-mcp.mjs doctor",
    "mcp:install": "node .agents/skills/mcp-bootstrap/scripts/ensure-mcp.mjs install",
    "mcp:sync": "node .agents/skills/mcp-bootstrap/scripts/ensure-mcp.mjs sync --write"
  }
}
